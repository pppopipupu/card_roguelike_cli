[Unit]
Description=Card Roguelike Action API
After=network.target

[Service]
Type=simple
User=rogue
WorkingDirectory=/opt/rogue/card_roguelike_cli
EnvironmentFile=/opt/rogue/rogue.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/rogue/venv/bin/uvicorn server.app:create_app --factory --host 127.0.0.1 --port 8787 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/rogue/data

[Install]
WantedBy=multi-user.target
